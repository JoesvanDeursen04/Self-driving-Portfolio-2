<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- Main Integration Launch File -->
    <!-- Launches all localization and mapping components -->
    
    <!-- Robot name -->
    <arg name="robot_name" default="duckiebot"/>
    <!-- Set to true for real Duckiebot (compressed camera), false for simulator -->
    <arg name="use_compressed" default="true"/>
    
    <group ns="$(arg robot_name)">
        <!-- ========== Odometry Node ========== -->
        <!-- Estimates robot position from wheel encoder data -->
        <include file="$(find dbot_odometry)/launch/odometry.launch">
            <arg name="robot_name" value="$(arg robot_name)"/>
        </include>
        
        <!-- ========== SLAM Node ========== -->
        <!-- Detects and tracks visual features from camera -->
        <include file="$(find dbot_slam)/launch/slam.launch">
            <arg name="robot_name" value="$(arg robot_name)"/>
            <arg name="use_compressed" value="$(arg use_compressed)"/>
        </include>
        
        <!-- ========== Sensor Fusion Node ========== -->
        <!-- Fuses odometry and SLAM measurements using EKF -->
        <include file="$(find dbot_sensor_fusion)/launch/fusion.launch">
            <arg name="robot_name" value="$(arg robot_name)"/>
        </include>

        <!-- ========== Semantic Perception Node ========== -->
        <!-- Detects AprilTags and duckies and maps them as semantic landmarks -->
        <include file="$(find dbot_semantics)/launch/semantic_perception.launch">
            <arg name="robot_name" value="$(arg robot_name)"/>
            <arg name="use_compressed" value="$(arg use_compressed)"/>
        </include>
    </group>
    
    <!-- Optional: Launch RViz for visualization -->
    <arg name="launch_rviz" default="true"/>
    <node if="$(arg launch_rviz)" name="rviz" pkg="rviz" type="rviz" 
          args="-d $(find dbot_odometry)/rviz/localization.rviz"
          output="screen">
    </node>
    
</launch>
