<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- SLAM Node Launch File -->

    <!-- Robot name parameter -->
    <arg name="robot_name" default="duckiebot"/>
    <!-- Set to true for real Duckiebot (compressed camera), false for simulator (raw) -->
    <arg name="use_compressed" default="true"/>

    <!-- ========== SLAM Node ========== -->
    <node name="slam_node" pkg="dbot_slam" type="slam_node.py" output="screen">
        <param name="robot_name" value="$(arg robot_name)"/>

        <!-- Camera calibration parameters (fallback; camera_info topic takes priority) -->
        <param name="focal_length_x" value="183"/>
        <param name="focal_length_y" value="183"/>
        <param name="principal_point_x" value="160"/>
        <param name="principal_point_y" value="120"/>

        <!-- Image transport mode -->
        <param name="use_compressed" value="$(arg use_compressed)"/>
        <param name="camera_topic" value="/$(arg robot_name)/camera_node/image/compressed" if="$(arg use_compressed)"/>
        <param name="camera_topic" value="/$(arg robot_name)/camera/image_raw" unless="$(arg use_compressed)"/>
    </node>

</launch>
